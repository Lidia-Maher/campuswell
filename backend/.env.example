# Copy this file to .env and fill in the values. Never commit .env.

ENVIRONMENT=development

# PostgreSQL connection string (Neon / Supabase / local)
DATABASE_URL=postgresql://user:password@localhost:5432/campuswell

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Firebase service account: use ONE of these
# Local: path to the JSON file downloaded from Firebase console
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# Render: paste the whole JSON file content as one line
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# Local testing without Firebase: send "Authorization: Bearer dev:<name>"
# Never enable in production (the app refuses to start if you do).
AUTH_DEV_MODE=false
