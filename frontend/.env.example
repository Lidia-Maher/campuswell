# Copy this file to .env.local and fill it in. .env.local is not committed.

# Which backend to call:
#   your laptop:  http://localhost:8000   (run the backend with uvicorn)
#   live API:     https://campuswell-api.onrender.com
VITE_API_URL=http://localhost:8000

# Show the "dev login" box (type sara, admin, counsellor...). Only works with a backend
# that has AUTH_DEV_MODE=true, i.e. your own laptop. Never set this on Vercel.
VITE_DEV_LOGIN=true

# Firebase web app config: Firebase console > Project settings > General > Your apps.
# These values are public (they ship to every browser), but keep them in .env.local
# so each environment can point at its own project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=campuswell-df5f5.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=campuswell-df5f5
VITE_FIREBASE_APP_ID=
